commit_msg=$(cat "$1")

if ! echo "$commit_msg" | grep -qE '^(feat|fix|test|docs|refactor|chore|perf|style|build|ci): '; then
  echo ""
  echo "❌ Invalid commit!"
  echo ""
  echo "Commit needs to start with a prefix:"
  echo ""
  echo "  feat:      new functionality"
  echo "  fix:       correction"
  echo "  test:      tests"
  echo "  docs:      documentation"
  echo "  refactor:  refactoring"
  echo "  chore:     maintenance"
  echo "  perf:      performance"
  echo "  style:     formatting"
  echo "  build:     build"
  echo "  ci:        CI/CD"
  echo ""
  echo "Example:"
  echo "  feat: adds postgres support"
  echo ""
  exit 1
fi