{
  "name": "env-lib-check",
  "version": "0.8.2",
  "description": "CLI that scans your codebase for process.env usage and warns about missing or empty environment variables before they become a production bug.",
  "main": "./dist/cli.js",
  "scripts": {
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "dev": "npx tsx watch ./src/cli.ts",
    "start": "node ./dist/cli.js",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "env",
    "environment-variable",
    "environment-variables",
    "dotenv",
    "env-validator",
    "env-checker",
    "env-security",
    "secret-scanner",
    "git-secrets",
    "git-security",
    "secret-detection",
    "credentials",
    "api-key",
    "process.env"
  ],
  "author": "Stênio Sousa Fonteles",
  "license": "ISC",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "elc": "./dist/cli.js"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "simple-git": "^3.36.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "husky": "^9.1.7",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
